# Backend (usare user-secrets o variabili con doppio underscore)
ConnectionStrings__Silvae=Host=localhost;Port=5432;Database=silvae;Username=postgres;Password=change-me
Authentication__Authority=https://YOUR_PROJECT.supabase.co/auth/v1
Authentication__Audience=authenticated

# Abilita POST /api/bootstrap/organization, che crea la prima organizzazione
# e il suo amministratore. Su un ambiente già inizializzato va lasciata vuota:
# senza valore l'endpoint risponde 403.
SILVAE_BOOTSTRAP_SECRET=

# Flutter: passare con --dart-define, non caricare questo file nell'app.
SILVAE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SILVAE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SILVAE_API_BASE_URL=https://api.example.test
SILVAE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
