{
  "openapi": "3.1.1",
  "info": {
    "title": "Silvae.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5089/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/worksites": {
      "get": {
        "tags": [
          "Worksites"
        ],
        "operationId": "GetAssignedWorksites",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorksiteDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/push": {
      "post": {
        "tags": [
          "Sync"
        ],
        "operationId": "PushSyncOperations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushSyncResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/pull": {
      "get": {
        "tags": [
          "Sync"
        ],
        "operationId": "PullSyncChanges",
        "parameters": [
          {
            "name": "changedSince",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullSyncResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentUserDto": {
        "required": [
          "userId",
          "selectedOrganizationId",
          "memberships"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedOrganizationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipDto"
            }
          }
        }
      },
      "DailyReportSyncDto": {
        "required": [
          "id",
          "organizationId",
          "worksiteId",
          "authorId",
          "reportDate",
          "notes",
          "status",
          "version",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "worksiteId": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "reportDate": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "JsonElement": {},
      "MembershipDto": {
        "required": [
          "organizationId",
          "displayName",
          "role"
        ],
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "PullSyncResponse": {
        "required": [
          "dailyReports",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "dailyReports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyReportSyncDto"
            }
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PushSyncRequest": {
        "required": [
          "operations"
        ],
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncOperationDto"
            }
          }
        }
      },
      "PushSyncResponse": {
        "required": [
          "operations",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncOperationResultDto"
            }
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SyncOperationDto": {
        "required": [
          "operationId",
          "organizationId",
          "entityId",
          "entityType",
          "operationType",
          "expectedVersion",
          "payload",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "entityType": {
            "type": "string"
          },
          "operationType": {
            "type": "string"
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "payload": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SyncOperationResultDto": {
        "required": [
          "operationId",
          "entityId",
          "version",
          "wasDuplicate"
        ],
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "wasDuplicate": {
            "type": "boolean"
          }
        }
      },
      "WorksiteDto": {
        "required": [
          "id",
          "code",
          "name",
          "address",
          "jobOrderId",
          "jobOrderCode",
          "jobOrderName",
          "version",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "jobOrderId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "jobOrderCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "jobOrderName": {
            "type": [
              "null",
              "string"
            ]
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Identity"
    },
    {
      "name": "Worksites"
    },
    {
      "name": "Sync"
    }
  ]
}
